# Copy to .env.local and fill in the values.
# Public values only — everything here ships to the browser.
# Express API base URL (routes are mounted under /api).
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# This app's own origin (used by Better Auth).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only — keep these out of client components.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-string
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/pizzahub?retryWrites=true&w=majority
MONGODB_DB=pizzahub
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me


STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ID=price_replace_me
PUBLISH_KEY=pk_test_replace_me

# --- ImgBB — menu item image hosting ---
IMGBB_API_KEY=replace-me-please
